{
    "swagger": "2.0",
    "info": {
        "description": "Simple API to communicate with Webtor service.",
        "title": "Webtor API",
        "contact": {
            "name": "Webtor Support",
            "url": "https://webtor.io/support",
            "email": "support@webtor.io"
        },
        "version": "0.1"
    },
    "paths": {
        "/resource/": {
            "post": {
                "description": "Receives torrent or magnet-uri in request body.\nIf magnet-uri provided instead of torrent, then it tries to fetch torrent from BitTorrent network (timeout 3 minutes).\nA magnet-uri without tr= trackers that resolves to a private (BEP 27) torrent not stored yet is refused with 422 private_magnet: such a torrent only works through trackers, so upload its .torrent file or add your tracker to the magnet.\nA private torrent is answered with \"private\": true and without its trackers. Who calls is read from the signed X-Token header only.\nA private .torrent or magnet is stored for the caller; torrent-store's refusal is a 422 with code private_needs_account, private_unavailable, private_no_tracker or private_too_many_trackers.\nA magnet with tr= for a stored private torrent goes through when the caller has a record of it. Otherwise its trackers are checked: accepted stores it for the caller and answers \"verified\": \"accepted\"; refused is 422 private_tracker_refused with the tracker's reason; invalid is 422 private_no_tracker; an unavailable check is 503 private_verify_unavailable with Retry-After. Checks are limited per user: 429 with Retry-After.\nAn infohash or a magnet without tr= of a stored private torrent is answered as GET /resource/{resource_id}: 403 private_torrent (reason sign_in, no_record or token_in_query) or 403 private_unavailable.\nA private torrent is answered 503 when torrent-store cannot decide: with code store_outdated if it predates private records, without code if it is unavailable.",
                "consumes": [
                    "*/*"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "resource"
                ],
                "summary": "Stores resource",
                "parameters": [
                    {
                        "example": "\"magnet:?xt=urn:btih:08ada5a7a6183aae1e09d831df6748d566095a10\u0026dn=Sintel\u0026tr=udp%3A%2F%2Ftracker.leechers-paradise.org%3A6969\u0026tr=udp%3A%2F%2Ftracker.coppersurfer.tk%3A6969\u0026tr=udp%3A%2F%2Ftracker.opentrackr.org%3A1337\u0026tr=udp%3A%2F%2Fexplodie.org%3A6969\u0026tr=udp%3A%2F%2Ftracker.empire-js.us%3A1337\u0026tr=wss%3A%2F%2Ftracker.btorrent.xyz\u0026tr=wss%3A%2F%2Ftracker.openwebtorrent.com\u0026tr=wss%3A%2F%2Ftracker.fastcast.nz\u0026ws=https%3A%2F%2Fwebtorrent.io%2Ftorrents%2F\"",
                        "description": "resource",
                        "name": "resource",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/services.ResourceResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "408": {
                        "description": "Request Timeout",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/resource/{resource_id}": {
            "get": {
                "description": "Receives resource id and returns resource.\nA private (BEP 27) torrent (\"private\": true) is answered only to a signed-in caller with a record of it; who calls is read from the signed X-Token header only.\nOtherwise 403 with code private_torrent and reason sign_in, no_record or token_in_query (a token in the token query parameter), or 403 private_unavailable.\nA private torrent is answered 503 when torrent-store cannot decide: with code store_outdated if it predates private records, without code if it is unavailable.",
                "consumes": [
                    "*/*"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "resource"
                ],
                "summary": "Returns resource",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"08ada5a7a6183aae1e09d831df6748d566095a10\"",
                        "description": "resource_id",
                        "name": "resource_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/services.ResourceResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/resource/{resource_id}.torrent": {
            "get": {
                "description": "Receives id and returns torrent file (binary, Content-Type application/x-bittorrent) for resource.\nThe .torrent of a private (BEP 27) torrent is served to internal callers only: 403 with code private_torrent_file.",
                "consumes": [
                    "*/*"
                ],
                "produces": [
                    "application/x-bittorrent"
                ],
                "tags": [
                    "resource"
                ],
                "summary": "Returns torrent for resource",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"08ada5a7a6183aae1e09d831df6748d566095a10\"",
                        "description": "resource_id",
                        "name": "resource_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "torrent file",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/resource/{resource_id}/export/{content_id}": {
            "get": {
                "description": "Provides url for exporting resource content. content_id is\neither the SHA1 of the file's path (returned by /list) or\nthe file's index in the torrent's natural file order\n(matches the fileIdx convention used by Stremio addons).\nA private (BEP 27) torrent (\"private\": true) is answered only to a signed-in caller with a record of it; who calls is read from the signed X-Token header only.\nOtherwise 403 with code private_torrent and reason sign_in, no_record or token_in_query (a token in the token query parameter), or 403 private_unavailable.\nA private torrent is answered 503 when torrent-store cannot decide: with code store_outdated if it predates private records, without code if it is unavailable.\nThe export urls of a private torrent carry a token re-signed to the resource and the caller, valid for at most 24 hours.",
                "consumes": [
                    "*/*"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "export"
                ],
                "summary": "Exports resource content",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"08ada5a7a6183aae1e09d831df6748d566095a10\"",
                        "description": "resource_id",
                        "name": "resource_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "\"ca2453df3e7691c28934eebed5a253ee0aabd29f\"",
                        "description": "content_id",
                        "name": "content_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "\"download,stream\"",
                        "description": "comma-separated list of export types to generate; allowed values: download, stream, torrent_client_stat, subtitles, media_probe; if omitted or empty, all types are exported; an unknown value yields 400",
                        "name": "types",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "API key embedded into the generated export URLs; falls back to X-Api-Key header, then to the server-configured key",
                        "name": "api-key",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "API key embedded into the generated export URLs (used if api-key query parameter is absent)",
                        "name": "X-Api-Key",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "JWT embedded into the generated export URLs; falls back to X-Token header; if neither is provided, the server signs its own token with the configured role; the token's role claim selects the download subdomains",
                        "name": "token",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "JWT embedded into the generated export URLs (used if token query parameter is absent)",
                        "name": "X-Token",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "opaque user identifier propagated into the generated export URLs; falls back to X-User-Id header",
                        "name": "user-id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "opaque user identifier propagated into the generated export URLs (used if user-id query parameter is absent)",
                        "name": "X-User-Id",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "request correlation identifier propagated into the generated export URLs; falls back to X-Request-Id header",
                        "name": "request-id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "request correlation identifier propagated into the generated export URLs (used if request-id query parameter is absent)",
                        "name": "X-Request-Id",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "IMDB identifier forwarded into the subtitles export URL (subtitles type only)",
                        "name": "imdb-id",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "zip",
                            "tar"
                        ],
                        "type": "string",
                        "default": "zip",
                        "description": "archive format for directory downloads",
                        "name": "archive-format",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "limit a directory archive to the selected file/folder paths (repeatable); each path must exist in the torrent and be inside the exported directory; at most 1024 paths and about 6000 percent-encoded bytes in total",
                        "name": "paths",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/services.ExportResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/resource/{resource_id}/list": {
            "get": {
                "description": "Lists files and directories of specific resource.\nAll ids in response can be used for export.\nA private (BEP 27) torrent (\"private\": true) is answered only to a signed-in caller with a record of it; who calls is read from the signed X-Token header only.\nOtherwise 403 with code private_torrent and reason sign_in, no_record or token_in_query (a token in the token query parameter), or 403 private_unavailable.\nA private torrent is answered 503 when torrent-store cannot decide: with code store_outdated if it predates private records, without code if it is unavailable.",
                "consumes": [
                    "*/*"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "list"
                ],
                "summary": "Lists resource",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"08ada5a7a6183aae1e09d831df6748d566095a10\"",
                        "description": "resource_id",
                        "name": "resource_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "path",
                        "name": "path",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "limit",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "offset",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "list",
                            "tree"
                        ],
                        "type": "string",
                        "description": "output",
                        "name": "output",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "name",
                            "size"
                        ],
                        "type": "string",
                        "description": "sort order; if omitted, items are returned in the torrent's original file order",
                        "name": "sort",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/services.ListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/speedtest": {
            "get": {
                "description": "Returns urls for measuring download speed. Each url points to a /speedtest endpoint on a download host and carries the size, token and api-key query parameters.\nOne \"standard\" url. The token's role claim selects which download subdomains are eligible.",
                "consumes": [
                    "*/*"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "speedtest"
                ],
                "summary": "Returns speed test urls",
                "parameters": [
                    {
                        "type": "string",
                        "description": "JWT embedded into the generated speed test URLs; falls back to X-Token header; if neither is provided, the server signs its own token with the configured role",
                        "name": "token",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "JWT embedded into the generated speed test URLs (used if token query parameter is absent)",
                        "name": "X-Token",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "API key embedded into the generated speed test URLs; falls back to X-Api-Key header, then to the server-configured key",
                        "name": "api-key",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "API key embedded into the generated speed test URLs (used if api-key query parameter is absent)",
                        "name": "X-Api-Key",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/services.SpeedtestResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "services.ErrorResponse": {
